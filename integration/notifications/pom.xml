<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.16</version><relativePath/></parent>
  <groupId>sg.edu.nus.serms</groupId><artifactId>serms-notification-postgres</artifactId><version>0.1.0-SNAPSHOT</version>
  <properties><java.version>17</java.version></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-data-jpa</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-core</artifactId><scope>provided</scope></dependency>
    <dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId><scope>runtime</scope></dependency>
    <dependency><groupId>org.postgresql</groupId><artifactId>postgresql</artifactId><version>42.7.13</version><scope>runtime</scope></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-web</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>../../database/src/main/resources/db/migration</directory><targetPath>db/serms-shared</targetPath></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.codehaus.mojo</groupId><artifactId>build-helper-maven-plugin</artifactId><version>3.6.1</version>
        <executions>
          <execution><id>compile-against-upstream-contract</id><phase>generate-sources</phase><goals><goal>add-source</goal></goals>
            <configuration><sources><source>src/contract/java</source></sources></configuration></execution>
          <execution><id>upstream-test-implementation</id><phase>generate-test-sources</phase><goals><goal>add-test-source</goal></goals>
            <configuration><sources><source>${project.basedir}/../../.cache/notification-upstream/src</source></sources></configuration></execution>
        </executions>
      </plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId>
        <configuration><excludes><exclude>sg/edu/nus/serms/notification/**</exclude></excludes></configuration>
      </plugin>
      <plugin><groupId>org.flywaydb</groupId><artifactId>flyway-maven-plugin</artifactId><version>${flyway.version}</version>
        <configuration>
          <url>${env.SERMS_DB_URL}</url><user>${env.SERMS_DB_USER}</user><password>${env.SERMS_DB_PASSWORD}</password>
          <defaultSchema>public</defaultSchema><table>serms_flyway_history</table><baselineVersion>2</baselineVersion>
        </configuration>
        <dependencies><dependency><groupId>org.flywaydb</groupId><artifactId>flyway-database-postgresql</artifactId><version>${flyway.version}</version></dependency></dependencies>
      </plugin>
    </plugins>
  </build>
</project>