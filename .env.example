# Server-only /opt/agfp/.env. Fill from the real handover; do not commit values.
HOST_PORT=8789
SERMS_DB_NAME=serms
SERMS_DB_USER=serms
SERMS_DB_PASSWORD=
# Exact inventoried external PostgreSQL 18 volume. Compose never creates it silently.
SERMS_DB_VOLUME=
# Existing backup directory on the server, outside the Git checkout.
SERMS_BACKUP_DIR=/opt/serms-backups

# Native development uses scripts/start-local.ps1 and isolated generated credentials.
# Production always uses serms-postgres and Secure cookies; never set the local profile here.
