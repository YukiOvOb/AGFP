# Template for /opt/agfp/.env on the server (keep secrets on the server; never commit them to Git).
# scripts/deploy.sh reads these two values for health checks; add others as required by the application.
HOST_PORT=8789
HEALTH_PATH=/api/health

# Spring Boot and the PostgreSQL 18 development database.
# Root website deployment is still owned by the CI/CD member.
SERMS_DB_URL=jdbc:postgresql://127.0.0.1:55432/serms?currentSchema=serms,public
SERMS_DB_USER=serms
SERMS_DB_PASSWORD=
SERMS_DB_PORT=55432
SERMS_APPROVAL_ENABLED=true
